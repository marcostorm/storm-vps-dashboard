# --- Host único (setup clássico) ---
VPS_HOST=187.127.249.58
VPS_USER=root
VPS_PORT=22
VPS_KEY_PATH=~/.ssh/id_ed25519
# opcional, aparece como título do dashboard
VPS_LABEL=VPS Hostinger

# --- Múltiplos hosts (opcional; se setado, as vars acima são ignoradas) ---
# Lista separada por vírgula com um nome curto por host:
# VPS_HOSTS=hostinger,paxiuba
#
# Pra cada nome, define VPS_<NOME>_HOST / _USER / _PORT / _KEY_PATH / _LABEL:
# VPS_HOSTINGER_HOST=187.127.249.58
# VPS_HOSTINGER_USER=root
# VPS_HOSTINGER_PORT=22
# VPS_HOSTINGER_KEY_PATH=~/.ssh/id_ed25519
# VPS_HOSTINGER_LABEL=VPS Hostinger (srv1614515)
#
# VPS_PAXIUBA_HOST=143.95.185.95
# VPS_PAXIUBA_USER=root
# VPS_PAXIUBA_PORT=22022
# VPS_PAXIUBA_KEY_PATH=~/.ssh/paxiuba_admin_ed25519
# VPS_PAXIUBA_LABEL=VPS HostGator (Paxiúba)
