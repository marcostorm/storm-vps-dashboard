# Copiar pra /opt/stormlab/dashboard/.env (nunca commitar)
# Preenchido automaticamente pelo dashboard-deploy.sh na primeira execução.

# Domínio (A record aponta pra 187.127.249.58 no DNS do Hostinger)
DASHBOARD_DOMAIN=lab.marcostorm.com.br

# Nome da network externa do Traefik no VPS.
TRAEFIK_NETWORK_NAME=stormlab

# Hash BCrypt do htpasswd. Gerar com:
#   htpasswd -nbB marcos 'SUA_SENHA' | sed 's/\$/\$\$/g'
# (os `$$` escapam o `$` do BCrypt pra escape do compose). dashboard-deploy.sh faz isso.
TRAEFIK_BASIC_AUTH_USERS=

# Config do collector SSH loopback (host.docker.internal → VPS)
VPS_HOST=host.docker.internal
VPS_USER=root
VPS_PORT=22
VPS_KEY_PATH=/root/.ssh/id_ed25519
VPS_SKIP_HOST_KEY_CHECK=1
